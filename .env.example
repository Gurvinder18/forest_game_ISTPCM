# Which AI runs the game: "gemini" (default, needs the key below) or
# "lmstudio" (a model running locally in LM Studio; local only, not on Vercel)
LLM_PROVIDER=gemini

# LM Studio settings (only used when LLM_PROVIDER=lmstudio)
# LMSTUDIO_URL=http://localhost:1234/v1
# LMSTUDIO_MODEL=   # leave empty to use whichever model is loaded

# Google AI Studio API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_google_ai_studio_api_key

# Optional: models to try in order (comma-separated). Defaults:
# NARRATOR_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemma-4-31b-it
# STATUS_MODELS=gemini-3.1-flash-lite,gemma-4-31b-it,gemini-3.5-flash-lite
